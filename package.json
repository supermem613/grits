{
  "name": "grits",
  "version": "0.1.0",
  "description": "Typed, backend-independent Git repository API for filesystem and in-memory implementations.",
  "type": "module",
  "bin": {
    "grits": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "npm run lint",
    "build": "tsc",
    "test": "node test/run.mjs test/**/*.test.ts",
    "test:unit": "node test/run.mjs test/unit/**/*.test.ts",
    "test:integration": "node test/run.mjs test/integration/**/*.test.ts",
    "lint:oxlint": "oxlint -c oxlint.config.ts src/ test/",
    "lint": "npm run lint:oxlint && tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "author": "Marcus Markiewicz",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@oxlint/plugins": "^1.80.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "minimatch": "^10.0.1",
    "oxlint": "^1.80.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  }
}
